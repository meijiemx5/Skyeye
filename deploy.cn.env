# Skyeye 中国区（cn-northwest-1）部署配置
# 用法：  source ./deploy.cn.env && ./deploy.sh skyeye cn-northwest-1
#
# 这些都是资源“标识符”（域名 / 证书 ID / ARN），不是密钥凭证，可安全提交。
# 真正的密钥（证书私钥、JWT secret）不在这里。

# 前端 CloudFront 自定义域名 + IAM 证书（CloudFront 在中国区用 IAM 证书）
export SKYEYE_SITE_DOMAIN="ruianwy.site"
export SKYEYE_SITE_IAM_CERT_ID="ASCARF4GALIVNP3ZRZS2J"

# API Gateway 自定义域名 + ACM 证书 ARN（必须与 API 同区 cn-northwest-1）
export SKYEYE_API_DOMAIN="www.ruianwy.site"
export SKYEYE_API_CERT_ARN="arn:aws-cn:acm:cn-northwest-1:081348549162:certificate/b8904700-70cf-4d14-9b2c-6a46c5c7bd99"
